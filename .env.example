# Mizan configuration. Copy to .env and fill in. Never commit the real key.
GROQ_API_KEY=

# groq (hosted) or ollama (local)
CONTRACT_AI_PROVIDER=groq

# --- optional overrides -----------------------------------------------------
# Analysis model. Free-tier limits differ per model - see README.
#   qwen/qwen3.8-27b     1000 req/day,  8000 TPM   (default)
#   openai/gpt-oss-20b   1000 req/day,  8000 TPM
#   groq/compound         250 req/day, 12000 TPM
# CONTRACT_AI_ANALYSIS_MODEL=qwen/qwen3.8-27b

# Must match the chosen model's real tokens-per-minute limit.
# CONTRACT_AI_TPM=8000

# CONTRACT_AI_MAX_CONCURRENCY=2

# Windows only, and only for scanned PDFs and images.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
